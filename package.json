{
  "name": "memory-wallet",
  "version": "1.0.0",
  "private": true,
  "description": "Memory Wallet - Your AI memory. Your rules. Local-first browser extension prototype.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-extract.mjs && node scripts/test-rank.mjs && node scripts/test-consent.mjs && node scripts/test-migration.mjs",
    "icons": "node scripts/icons.mjs",
    "fetch:model": "node scripts/fetch-model.mjs",
    "check:model": "node scripts/fetch-model.mjs --check",
    "eval:retrieval": "node scripts/eval-retrieval.mjs",
    "check:no-remote": "node scripts/check-no-remote.mjs",
    "build": "node scripts/build.mjs",
    "release": "node scripts/build.mjs --production --zip && node scripts/check-no-remote.mjs",
    "watch": "node scripts/build.mjs --watch",
    "split-memory": "node scripts/split-memory.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.23.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "gifenc": "^1.0.3",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "sharp": "^0.35.5",
    "typescript": "^5.5.4"
  }
}
